 const uint8_t SOCKS5ClientSocket::kNullByte = 0x00;
 
+// CAMOUWOLF: the method numbers of RFC 1928 section 3.
+constexpr uint8_t kNoAuthentication = 0x00;
+constexpr uint8_t kUsernamePassword = 0x02;
+
+std::optional<Socks5Credentials> Socks5CredentialsFor(
+    const HostPortPair& proxy) {
+  // proxy:socks5Credentials maps "host:port" to {username, password}.
+  const base::DictValue* all =
+      base::CamouwolfConfig::Get().GetDict("proxy:socks5Credentials");
+  const base::DictValue* entry = all ? all->FindDict(proxy.ToString()) : nullptr;
+  const std::string* username = entry ? entry->FindString("username") : nullptr;
+  const std::string* password = entry ? entry->FindString("password") : nullptr;
+  if (!username || !password) {
+    return std::nullopt;
+  }
+  return Socks5Credentials{*username, *password};
+}
+
+std::vector<uint8_t> Socks5Greeting(bool with_credentials) {
+  if (with_credentials) {
+    return {0x05, 2, kNoAuthentication, kUsernamePassword};
+  }
+  return {0x05, 1, kNoAuthentication};
+}
+
+std::vector<uint8_t> Socks5PasswordRequest(
+    const Socks5Credentials& credentials) {
+  // Each field is one length byte and 1 to 255 bytes; the launcher refuses
+  // anything longer, so a clamp here never truncates a real credential.
+  std::vector<uint8_t> request = {0x01};
+  for (const std::string* field : {&credentials.username, &credentials.password}) {
+    const size_t length = std::min<size_t>(field->size(), 0xFF);
+    request.push_back(static_cast<uint8_t>(length));
+    request.insert(request.end(), field->begin(), field->begin() + length);
+  }
+  return request;
+}
