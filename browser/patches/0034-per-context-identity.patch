+namespace {
+
+// CAMOUWOLF: the WebRTC addresses of the process's context's identity. The
+// network service is shared by every context, so it is told, not asked.
+std::vector<net::IPAddress> CamouwolfIdentityAddresses(
+    RenderProcessHostImpl& process) {
+  const base::CamouwolfConfig& config =
+      base::CamouwolfConfig::ForContext(process.GetBrowserContext());
+  std::vector<net::IPAddress> addresses;
+  for (std::optional<std::string> value :
+       {config.GetString("webrtc:ipv4"), config.GetString("webrtc:ipv6")}) {
+    if (value) {
+      if (std::optional<net::IPAddress> address =
+              net::IPAddress::FromIPLiteral(*value)) {
+        addresses.push_back(*address);
+      }
+    }
+  }
+  return addresses;
+}
