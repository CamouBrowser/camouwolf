+// CAMOUWOLF: a context created over CDP takes an identity of its own.
+//
+// It is accepted only before the context has a renderer process: a renderer
+// adopts its context's identity once, as it starts, and the pages of one
+// context must never disagree. The languages go to the context's own
+// language prefs, which an off-the-record profile keeps in memory, so
+// the Accept-Language header and navigator.languages come from the one place
+// they come from for the launch.
+protocol::Response TargetHandler::SetBrowserContextIdentity(
+    const std::string& browser_context_id,
+    const std::string& identity,
+    std::unique_ptr<protocol::Array<std::string>> languages) {
+  if (!is_trusted_) {
+    return protocol::Response::ServerError(
+        "Cannot set an identity from untrusted client");
+  }
+  Profile* profile =
+      DevToolsBrowserContextManager::GetInstance().GetProfileById(
+          browser_context_id);
+  if (!profile || !profile->IsOffTheRecord()) {
+    return protocol::Response::InvalidParams(
+        "Only a context made by Target.createBrowserContext takes an identity");
+  }
+  if (languages->empty()) {
+    return protocol::Response::InvalidParams("languages is empty");
+  }
+  content::BrowserContext* context = profile;
+  for (auto hosts = content::RenderProcessHost::AllHostsIterator();
+       !hosts.IsAtEnd(); hosts.Advance()) {
+    if (hosts.GetCurrentValue()->GetBrowserContext() == context) {
+      return protocol::Response::ServerError(
+          "The browser context already has a renderer");
+    }
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(identity, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return protocol::Response::InvalidParams("identity is not a JSON object");
+  }
+  // Intl's default locale is the UI locale Chrome resolves the first language
+  // to, as it does the launch's (see 0026). GetApplicationLocale ignores its
+  // argument on Linux and answers the process's LANGUAGE, the launch's, so the
+  // language is resolved here, with its en-US fallback.
+  if (!dict->contains("locale:intl")) {
+    dict->Set("locale:intl", l10n_util::CheckAndResolveLocale(languages->front())
+                                 .value_or("en-US"));
+  }
+  CHECK(base::CamouwolfConfig::SetForContext(
+      context, base::WriteJson(*dict).value()));
+  // Every tab's LanguagePrefs derives the accept list from the selected one,
+  // so both are the context's.
+  const std::string language_list = base::JoinString(*languages, ",");
+  profile->GetPrefs()->SetString(language::prefs::kSelectedLanguages,
+                                 language_list);
+  profile->GetPrefs()->SetString(language::prefs::kAcceptLanguages,
+                                 language_list);
+  // The network context was made with the context, under the launch's
+  // identity; one made from now on takes the context's.
+  base::CamouwolfConfig::ScopedIdentity scoped(context);
+  const std::string user_agent = embedder_support::GetUserAgent();
+  profile->ForEachLoadedStoragePartition(
+      [&](content::StoragePartition* partition) {
+        partition->GetNetworkContext()->SetUserAgent(user_agent);
+      });
   return protocol::Response::Success();
 }
 
