 unsigned Screen::pixelDepth() const {
+  // CAMOUWOLF: Chrome ties pixelDepth to colorDepth, and so does this when only
+  // colorDepth is configured. The separate key exists for schema parity with
+  // Camoufox, whose fingerprints carry both; the launcher writes them equal.
+  if (const auto v = base::CamouwolfConfig::Get().GetUint32("screen.pixelDepth")) {
+    return *v;
+  }
   return colorDepth();
 }
 
