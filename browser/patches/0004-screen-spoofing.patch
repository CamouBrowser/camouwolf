 bool Screen::isExtended() const {
+  // CAMOUWOLF: a multi-monitor claim the identity did not ask for is a mismatch with
+  // the single screen.* rect above, so this is configurable and defaults false
+  // whenever any screen.* key is set.
+  if (const auto v = base::CamouwolfConfig::Get().GetBool("screen.isExtended")) {
