+// CAMOUWOLF: read one screen.* key, falling back to the real value.
+//
+// These are separate keys rather than a rect because the launcher fixes the
+// four of them to a *coherent* set: a real desktop always has
+// availHeight < height (the taskbar/menu-bar inset) on at least one axis.
+// CreepJS raises a `noTaskbar` headless flag when screen == avail on BOTH axes,
+// which is exactly what a stock headless Chromium reports, so the launcher
+// enforces the inset and this patch just serves what it decided.
 int Screen::height() const {
+  if (const auto v = base::CamouwolfConfig::Get().GetInt("screen.height")) {
+    return *v;
+  }
   if (!DomWindow())
     return 0;
   return GetRect(/*available=*/false).height();
 }
 
