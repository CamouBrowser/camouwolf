 namespace blink {
+
+namespace {
+
+// CAMOUWOLF: the identity's installed-font set, parsed once per process.
+//
+// Hoisted into a NoDestructor because this is consulted on every font lookup —
+// once per family per FontDescription — and re-walking the config there would
+// show up in layout. Null when the launch carried no "fonts" key, which is the
+// signal to leave upstream behavior alone.
+//
+// Names are compared ASCII-lowercased, matching CamouwolfConfig::GetStringListLower
+// byte for byte, because CSS family matching is case-insensitive: a page asking
+// for "segoe ui" must get the same answer as one asking for "Segoe UI".
+const base::flat_set<std::string>* CamouwolfInstalledFonts() {
+  static const base::NoDestructor<base::flat_set<std::string>> kInstalled([] {
+    const std::vector<std::string> fonts =
+        base::CamouwolfConfig::Get().GetStringListLower("fonts");
+    return base::flat_set<std::string>(fonts.begin(), fonts.end());
+  }());
+  return kInstalled->empty() ? nullptr : kInstalled.get();
+}
+
+std::string CamouwolfAsciiLower(const AtomicString& name) {
+  std::string utf8 = name.Utf8();
+  std::transform(utf8.begin(), utf8.end(), utf8.begin(), [](unsigned char c) {
+    return static_cast<char>(std::tolower(c));
+  });
+  return utf8;
+}
+
+}  // namespace
+
+// static
+bool CSSFontSelectorBase::CamouwolfFamilyInstalled(const FontFamily& family) {
+  // A CSS generic keyword (serif, sans-serif, monospace, cursive, fantasy,
+  // system-ui, math) is not an installed face — it is a request for whatever
+  // the platform maps that keyword to. Blocking one would leave a document with
+  // no usable font at all rather than making it look like a different machine,
+  // so generics always fall through and the last-resort fallback keeps working.
+  if (family.FamilyIsGeneric()) {
+    return true;
+  }
+  const base::flat_set<std::string>* installed = CamouwolfInstalledFonts();
+  if (!installed) {
+    return true;
+  }
+  const AtomicString& name = family.FamilyName();
+  if (name.empty()) {
+    return true;
+  }
+  return installed->contains(CamouwolfAsciiLower(name));
+}
 
