+ShadowRoot* Element::ShadowRootForBindings(ScriptState* script_state) const {
+  // CAMOUWOLF: Playwright's selectors run in a DevTools isolated world and
+  // read Element.shadowRoot, so this lets them reach into a closed root as a
+  // user can. A page cannot run in that world; it still gets null.
+  if (script_state->World().GetWorldType() ==
+      DOMWrapperWorld::WorldType::kInspectorIsolated) {
+    return AuthorShadowRoot();
+  }
+  return OpenShadowRoot();
+}
