 bool ImageDataBuffer::EncodeImage(const ImageEncodingMimeType mime_type,
                                   const double& quality,
                                   Vector<unsigned char>* encoded_image) const {
-  return ImageEncoder::Encode(encoded_image, pixmap_, mime_type, quality);
+  // CAMOUWOLF: farble before encoding, so canvas.toDataURL() / toBlob() and
+  // getImageData() agree.
+  //
+  // This is the path a detector actually uses most: the classic canvas
+  // fingerprint is a hash of toDataURL() output. Patching only getImageData()
+  // would leave it untouched — and worse, would make the two disagree, which is
+  // a stronger signal than either hash alone.
+  //
+  // Only lossless encodings are perturbed. A JPEG/WebP quality pass destroys a
+  // +/-1 delta anyway (so it would be wasted work) while the DCT ringing it
+  // introduces can amplify the delta into something visible, so we leave lossy
+  // output to the encoder.
+  const uint32_t seed = base::CamouwolfVisualSeed();
+  if (seed == 0u || mime_type != kMimeTypePng) {
+    return ImageEncoder::Encode(encoded_image, pixmap_, mime_type, quality);
+  }
+  // pixmap_ is const; copy so the caller's backing store is never mutated —
+  // a canvas whose pixels changed under it would break putImageData round
+  // trips and repaint.
+  SkBitmap farbled;
+  if (!farbled.tryAllocPixels(pixmap_.info()) ||
+      !pixmap_.readPixels(farbled.pixmap())) {
+    return ImageEncoder::Encode(encoded_image, pixmap_, mime_type, quality);
+  }
+  base::CamouwolfFarbleRGBA(gfx::SkPixmapToWritableSpan(farbled.pixmap()));
+  return ImageEncoder::Encode(encoded_image, farbled.pixmap(), mime_type,
+                              quality);
