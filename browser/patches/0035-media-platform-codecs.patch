+// CAMOUWOLF: the identity's hardware codec formats, as "name|fmtp" entries;
+// nullopt when the launcher claimed none, leaving the host's GPU to answer.
+std::optional<std::vector<webrtc::SdpVideoFormat>> ClaimedFormats(
+    const base::ListValue* entries) {
+  if (!entries) {
+    return std::nullopt;
+  }
+  std::vector<webrtc::SdpVideoFormat> formats;
+  for (const base::Value& entry : *entries) {
+    if (!entry.is_string()) {
+      continue;
+    }
+    auto [name, fmtp] = base::SplitStringOnce(entry.GetString(), '|')
+                            .value_or(std::make_pair(
+                                std::string_view(entry.GetString()),
+                                std::string_view()));
+    webrtc::CodecParameterMap parameters;
+    base::StringPairs pairs;
+    base::SplitStringIntoKeyValuePairs(fmtp, '=', ';', &pairs);
+    for (auto& [parameter, value] : pairs) {
+      parameters[parameter] = value;
+    }
+    formats.emplace_back(std::string(name), parameters);
+  }
+  return formats;
+}
+
+// The codec a format names, as media::GetCodecName spells it.
+std::string FormatCodecName(const webrtc::SdpVideoFormat& format) {
+  std::optional<media::VideoCodecProfile> profile =
+      WebRTCFormatToCodecProfile(format);
+  return profile ? media::GetCodecName(
+                       media::VideoCodecProfileToVideoCodec(*profile))
+                 : std::string();
+}
+
+// CAMOUWOLF: support as the identity's GPU reports it: a claimed format is
+// supported, and a supported format of a hardware codec is power efficient.
+template <typename Support>
+Support ClaimedSupport(Support support,
+                       const std::vector<webrtc::SdpVideoFormat>& claimed,
+                       std::optional<bool> hardware,
+                       const webrtc::SdpVideoFormat& format) {
+  if (format.IsCodecInList(claimed)) {
+    support.is_supported = true;
+  }
+  support.is_power_efficient = support.is_supported && hardware.value_or(false);
+  return support;
+}
