diff --git a/third_party/blink/renderer/core/html/canvas/text_metrics.cc b/third_party/blink/renderer/core/html/canvas/text_metrics.cc
--- a/third_party/blink/renderer/core/html/canvas/text_metrics.cc
+++ b/third_party/blink/renderer/core/html/canvas/text_metrics.cc
@@ -3,6 +3,8 @@
 // found in the LICENSE file.
 
 #include "third_party/blink/renderer/core/html/canvas/text_metrics.h"
+
+#include "base/camouwolf_farble.h"  // CAMOUWOLF
 
 #include "base/numerics/checked_math.h"
 #include "third_party/blink/renderer/bindings/core/v8/v8_canvas_text_align.h"
@@ -107,7 +109,17 @@
   direction_ = direction;
 
   auto [xpos, glyph_bounds] = MeasureRuns(text_painter);
-  double real_width = xpos;
+  // CAMOUWOLF: quantize the measured advance to the 26.6 fixed-point grid.
+  //
+  // measureText().width is a *font* fingerprint with far more entropy than the
+  // font list: its low mantissa bits encode the exact face, version, hinting
+  // settings and rasterizer, so a detector can measure a few strings and
+  // identify the machine even when the reported font list is generic. Rounding
+  // to 1/64 px is not arbitrary — it is the grid both FreeType and DirectWrite
+  // use internally, so every value we return is one the claimed platform could
+  // genuinely have produced. Rounding to whole pixels (the naive fix) produces
+  // values no real browser reports and is itself detectable.
+  double real_width = base::CamouwolfQuantizeTextMetric(xpos);
   width_ = real_width;
 
   text_align_dx_ = 0.0f;
