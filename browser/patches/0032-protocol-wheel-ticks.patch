+// CAMOUWOLF: wheelDelta is ticks * 120 and a page compares it with deltaY, so
+// count ticks in the pixels a tick scrolls on the OS navigator.platform claims:
+// 100 on Windows (web_input_event_builders_win.cc), kScrollbarPixelsPerCocoaTick
+// on macOS, Aura's kWheelDelta on Linux. Stock CDP sends one tick a call.
+// Blink divides both by devicePixelRatio, so ticks come from the scaled delta.
+void CamouwolfNativeWheelTicks(blink::WebMouseWheelEvent& event) {
+  const auto platform =
+      base::CamouwolfConfig::Get().GetString("navigator.platform");
+  if (!platform) {
+    return;
+  }
+  const double pixels_per_tick = *platform == "Win32"      ? 100.0
+                                 : *platform == "MacIntel" ? 40.0
+                                                           : 120.0;
+  event.wheel_ticks_x = event.delta_x / pixels_per_tick;
+  event.wheel_ticks_y = event.delta_y / pixels_per_tick;
+}
