 uint32_t NetworkInformation::rtt() {
+  // CAMOUWOLF: navigator.connection.rtt.
+  //
+  // Chrome quantizes this to a 25ms bucket, so the value itself is low entropy
+  // — but it is a strong *residency* signal when combined with the claimed
+  // timezone and exit IP: a "residential US" identity reporting a 0ms RTT is
+  // reporting a datacenter link. The launcher derives it from the proxy's
+  // measured latency when one is configured.
+  if (const auto v = base::CamouwolfConfig::Get().GetUint32("connection.rtt")) {
+    return *v;
+  }
   MaybeShowWebHoldbackConsoleMsg();
   std::optional<base::TimeDelta> override_rtt =
       GetNetworkStateNotifier().GetWebHoldbackHttpRtt();
