 double NetworkInformation::downlink() {
+  // CAMOUWOLF: paired with rtt() above — the launcher writes both or neither, since
+  // a spoofed RTT beside a host downlink is its own inconsistency.
+  if (const auto v = base::CamouwolfConfig::Get().GetDouble("connection.downlink")) {
+    return *v;
+  }
   MaybeShowWebHoldbackConsoleMsg();
   std::optional<double> override_downlink_mbps =
