diff --git a/third_party/blink/renderer/modules/webaudio/audio_buffer.h b/third_party/blink/renderer/modules/webaudio/audio_buffer.h
--- a/third_party/blink/renderer/modules/webaudio/audio_buffer.h
+++ b/third_party/blink/renderer/modules/webaudio/audio_buffer.h
@@ -122,6 +122,12 @@
   float sample_rate_;
   uint32_t length_;
 
+  // CAMOUWOLF: set once the rendered samples have been perturbed, so repeated
+  // getChannelData() calls return a STABLE buffer. Re-perturbing per call would
+  // make two reads of an unchanged buffer disagree, which no real machine does
+  // and which is a louder tell than the fingerprint being hidden.
+  bool camouwolf_farbled_ = false;
+
   HeapVector<Member<DOMFloat32Array>> channels_;
 };
 
diff --git a/third_party/blink/renderer/modules/webaudio/audio_buffer.cc b/third_party/blink/renderer/modules/webaudio/audio_buffer.cc
--- a/third_party/blink/renderer/modules/webaudio/audio_buffer.cc
+++ b/third_party/blink/renderer/modules/webaudio/audio_buffer.cc
@@ -28,6 +28,8 @@
 
 #include "third_party/blink/renderer/modules/webaudio/audio_buffer.h"
 
+#include "base/camouwolf_farble.h"  // CAMOUWOLF
+
 #include <memory>
 
 #include "base/check_op.h"
@@ -220,6 +222,34 @@
     return NotShared<DOMFloat32Array>(nullptr);
   }
 
+  // CAMOUWOLF: perturb the rendered samples once, in place, on first read.
+  //
+  // This is the OfflineAudioContext fingerprint: render an oscillator through a
+  // DynamicsCompressor, read the channel, sum it. The sum is stable to many
+  // decimal places on a given build+CPU, which is what makes it identifying.
+  //
+  // Perturbing ONCE and caching (camouwolf_farbled_) is the whole trick. The array
+  // handed back is the live buffer, so a page that calls getChannelData() twice
+  // gets the same object — if we re-perturbed per call, the second read would
+  // differ from the first and prove the buffer was being tampered with. Real
+  // hardware is stable across reads; so is this.
+  //
+  // Armed by AudioContext:randomizeSamples, NOT by canvas:seed. The audio
+  // residue this was written for is one 1000-sample chunk of ULP-scale
+  // platform-math drift (WINDOWS-DIVERGENCE §2.8) — an 0018-shaped problem that
+  // per-identity noise makes strictly worse, so this stays off by default and
+  // exists to measure the old posture.
+  const uint32_t camouwolf_seed = base::CamouwolfAudioSeed();
+  if (camouwolf_seed != 0u && !camouwolf_farbled_) {
+    camouwolf_farbled_ = true;
+    base::span<float> samples = channels_[channel_index]->AsSpan();
+    for (size_t i = 0; i < samples.size(); ++i) {
+      const int delta = base::CamouwolfPixelDelta(camouwolf_seed, i,
+                                              static_cast<uint8_t>(i & 0xffu));
+      samples[i] *= (1.0f + static_cast<float>(delta) * 1e-7f);
+    }
+  }
+
   return NotShared<DOMFloat32Array>(channels_[channel_index].Get());
 }
 
diff --git a/third_party/blink/renderer/modules/webaudio/realtime_analyser.cc b/third_party/blink/renderer/modules/webaudio/realtime_analyser.cc
--- a/third_party/blink/renderer/modules/webaudio/realtime_analyser.cc
+++ b/third_party/blink/renderer/modules/webaudio/realtime_analyser.cc
@@ -25,6 +25,8 @@
 
 #include "third_party/blink/renderer/modules/webaudio/realtime_analyser.h"
 
+#include "base/camouwolf_farble.h"  // CAMOUWOLF
+
 #include <limits.h>
 
 #include <algorithm>
@@ -124,11 +126,29 @@
   const size_t source_length = magnitude_buffer_.size();
   const size_t len = std::min(source_length, destination_array->length());
   if (len > 0) {
+    // CAMOUWOLF: seeded perturbation of the FFT magnitudes.
+    //
+    // The AnalyserNode path is the *realtime* audio fingerprint (the
+    // OfflineAudioContext one is handled in audio_buffer.cc). Both are read the
+    // same way — sum or hash the returned floats — so both need the same
+    // treatment or the two disagree.
+    //
+    // The delta is relative (a ~1e-7 scale factor) rather than absolute: these
+    // are decibel values spanning roughly -100..0, and a fixed epsilon would be
+    // invisible at the top of the range and dominant at the bottom. A relative
+    // nudge perturbs the hash uniformly while staying far below anything
+    // audible or measurable as distortion.
+    const uint32_t camouwolf_seed = base::CamouwolfAudioSeed();
     base::span<float> destination = destination_array->AsSpan();
     for (unsigned i = 0; i < len; ++i) {
       const float linear_value = magnitude_buffer_[i];
       const double db_mag = audio_utilities::LinearToDecibels(linear_value);
       destination[i] = static_cast<float>(db_mag);
+      if (camouwolf_seed != 0u) {
+        const int delta = base::CamouwolfPixelDelta(
+            camouwolf_seed, i, static_cast<uint8_t>(i & 0xffu));
+        destination[i] *= (1.0f + static_cast<float>(delta) * 1e-7f);
+      }
     }
   }
 }
