+/* CAMOUWOLF: RCPPS/RSQRTPS as the identity's x86 vendor computes them, from
+   the recorded table the embedder set (opus_cpu_identity.h). */
+static __m128 estimate_as(__m128 v, int rsqrt)
+{
+   const uint32_t *table = opus_cpu_estimates();
+   uint32_t b[4];
+   int i;
+   if (!table)
