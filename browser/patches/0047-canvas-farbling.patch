+class ExecutionContext;
+
+using CamouwolfFarblingToken = std::array<uint8_t, 16>;
+
+// Brave's canvas farbling, for an identity whose canvas is not the host's
+// (docs/PATCHES.md, 0047). The token is the context's top-level site keyed by
+// the launch's canvas:farblingToken; nullopt when the launch has none, or for
+// a page Brave leaves alone (not http or https).
+CORE_EXPORT std::optional<CamouwolfFarblingToken> CamouwolfCanvasFarblingToken(
+    ExecutionContext* context);
+
+// Brave's PerturbPixels, in place: flips the low bit of up to 512 bytes,
+// chosen by an HMAC of the pixels, so the same pixels on the same site always
+// farble the same way.
+CORE_EXPORT void CamouwolfPerturbPixels(const CamouwolfFarblingToken& token,
+                                        const SkPixmap& pixmap);
+
+// A farbled copy of `pixmap`, for pixels that may be the canvas's own snapshot,
+// which a write in place would change for every later read. Null when the copy
+// cannot be allocated.
+CORE_EXPORT sk_sp<SkImage> CamouwolfPerturbedCopy(
+    const CamouwolfFarblingToken& token,
+    const SkPixmap& pixmap);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_CAMOUWOLF_FARBLING_H_
