+#include "third_party/blink/renderer/core/page/frame_tree.h"
+#include "third_party/blink/renderer/core/workers/worker_global_scope.h"
+#include "third_party/blink/renderer/platform/network/blink_schemeful_site.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "ui/gfx/skia_span_util.h"
+
+namespace blink {
+
+namespace {
+
+// Brave's lfsr_next, verbatim.
+inline uint64_t LfsrNext(uint64_t v) {
+  constexpr uint64_t zero = 0;
+  return ((v >> 1) | (((v << 62) ^ (v << 61)) & (~(~zero << 63) << 62)));
+}
+
+// The origin Brave keys by: the top frame's, for a frame and for a worker
+// that a frame started.
+const SecurityOrigin* TopLevelOrigin(ExecutionContext* context) {
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    LocalFrame* frame = window->GetFrame();
+    if (!frame) {
+      return nullptr;
+    }
+    return frame->Tree().Top().GetSecurityContext()->GetSecurityOrigin();
+  }
+  if (auto* worker = DynamicTo<WorkerGlobalScope>(context)) {
+    if (const SecurityOrigin* top = worker->top_level_frame_security_origin()) {
+      return top;
+    }
+  }
+  return context->GetSecurityOrigin();
+}
+
+}  // namespace
+
+std::optional<CamouwolfFarblingToken> CamouwolfCanvasFarblingToken(
+    ExecutionContext* context) {
+  if (!context) {
+    return std::nullopt;
+  }
+  std::optional<std::string> hex =
+      base::CamouwolfConfig::Get().GetString("canvas:farblingToken");
+  if (!hex) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, 16> launch_token;
+  CHECK(base::HexStringToSpan(*hex, launch_token))
+      << "canvas:farblingToken is not 32 hex digits";
+  const SecurityOrigin* top = TopLevelOrigin(context);
+  if (!top || (top->Protocol() != "http" && top->Protocol() != "https")) {
+    return std::nullopt;
+  }
+  // Brave's token is random per site and session; this is the same, derived
+  // from one random token per launch. A storage-key nonce (a credentialless
+  // or fenced frame) changes it, as it changes Brave's.
+  std::string site = BlinkSchemefulSite(top).Serialize().Utf8();
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (const auto& nonce = window->GetStorageKey().GetNonce()) {
+      site += nonce->ToString();
+    }
+  }
+  auto keyed = crypto::hmac::SignSha256(launch_token, base::as_byte_span(site));
+  CamouwolfFarblingToken token;
+  base::span(token).copy_from(base::span(keyed).first<16u>());
+  return token;
+}
+
+// Brave's BraveSessionCache::PerturbPixelsInternal.
+void CamouwolfPerturbPixels(const CamouwolfFarblingToken& token,
+                            const SkPixmap& pixmap) {
+  base::span<uint8_t> pixels = gfx::SkPixmapToWritableSpan(pixmap);
+  const size_t pixel_count = pixels.size() / 4;
+  if (pixel_count == 0) {
+    return;
+  }
+  auto canvas_key = crypto::hmac::SignSha256(token, pixels);
+  uint64_t v = base::U64FromNativeEndian(base::span(canvas_key).first<8u>());
+  for (uint8_t key : canvas_key) {
+    uint8_t bit = key;
+    for (int j = 0; j < 16; j++) {
+      if (j % 8 == 0) {
+        bit = key;
+      }
+      uint8_t channel = v % 3;
+      size_t pixel_index = 4 * (v % pixel_count) + channel;
+      pixels[pixel_index] = pixels[pixel_index] ^ (bit & 0x1);
+      bit = bit >> 1;
+      v = LfsrNext(v);
+    }
+  }
+}
+
+sk_sp<SkImage> CamouwolfPerturbedCopy(const CamouwolfFarblingToken& token,
+                                      const SkPixmap& pixmap) {
+  SkBitmap copy;
+  if (!copy.tryAllocPixels(pixmap.info()) || !copy.writePixels(pixmap)) {
+    return nullptr;
+  }
+  CamouwolfPerturbPixels(token, copy.pixmap());
+  copy.setImmutable();
+  return copy.asImage();
+}
+
+}  // namespace blink
