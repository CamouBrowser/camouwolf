+// static
+bool IPAddress::IsIPv4OnlyNetwork() {
+  return base::CamouwolfConfig::Get().GetBool("network:ipv4Only").value_or(false);
+}
+
+bool IPAddress::IsUnreachableOnIPv4OnlyNetwork() const {
+  if (!IsIPv6() || !IsIPv4OnlyNetwork()) {
+    return false;
+  }
+  // Loopback, the any address, IPv4-mapped and link-local addresses need no
+  // IPv6 route, so they work on an IPv4-only network too.
+  return !IsZero() && !IsLoopback() && !IsIPv4MappedIPv6() && !IsLinkLocal();
+}
+
 bool IPAddress::IsUniqueLocalIPv6() const {
   // [fc00::]/7
   return IsIPv6() && ((ip_address_[0] & 0xFE) == 0xFC);
