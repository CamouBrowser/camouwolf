@@ -4,6 +4,7 @@
 
 #include "third_party/blink/renderer/modules/webaudio/realtime_audio_destination_handler.h"
 
+#include "base/camouwolf_config.h"  // CAMOUWOLF
 #include "base/feature_list.h"
 #include "base/metrics/histogram_macros.h"
 #include "media/base/output_device_info.h"
@@ -211,6 +212,16 @@
 }
 
 uint32_t RealtimeAudioDestinationHandler::MaxChannelCount() const {
+  // CAMOUWOLF: destination.maxChannelCount is the output device's channel
+  // count — 2 for stereo, 6 or 8 for a surround interface, 0 on a host with
+  // no device at all, which is what a server reports. Realtime contexts only:
+  // an OfflineAudioContext has no device and its destination takes the
+  // channel count it was constructed with (OfflineAudioDestinationHandler).
+  // The same answer bounds destination.channelCount, as the real one does.
+  if (const auto configured =
+          base::CamouwolfConfig::Get().GetUint32("AudioContext:maxChannelCount")) {
+    return *configured;
+  }
   return platform_destination_->MaxChannelCount();
 }
 
