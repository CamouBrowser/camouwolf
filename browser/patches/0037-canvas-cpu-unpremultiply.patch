+    sk_sp<SkData> raw = TryAllocateSkData(raw_info.computeMinByteSize());
+    if (!raw ||
+        !ri->ReadbackImagePixels(GetMailbox(), shared_image_->size(), raw_info,
+                                 static_cast<GLuint>(raw_info.minRowBytes()),
+                                 src_x, src_y, /*plane_index=*/0,
+                                 raw->writable_data())) {
+      return false;
+    }
+    return SkPixmap(raw_info, raw->data(), raw_info.minRowBytes())
+        .readPixels(dst_info, dst_pixels, dst_row_bytes);
+  }
   return ri->ReadbackImagePixels(GetMailbox(), shared_image_->size(), dst_info,
