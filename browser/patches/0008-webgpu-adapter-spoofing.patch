+      power_preference_(power_preference) {
+  // CAMOUWOLF: WebGPU adapter identity.
+  //
+  // GPUAdapterInfo is the WebGPU twin of WEBGL_debug_renderer_info, and a
+  // detector that reads BOTH catches a browser that only patched WebGL: the two
+  // APIs would name different GPUs on the same machine. The launcher writes
+  // these from the same adapter record that produced webGl:vendor and
+  // webGl:renderer, so the two APIs cannot disagree.
+  //
+  // Overridden here rather than in the accessors because those return
+  // `const String&`: a getter cannot return a reference to a value it builds,
+  // and caching one in a function-local static would pin the FIRST adapter's
+  // value for the life of the process. Assigning the members costs nothing and
+  // has no lifetime question.
+  const base::CamouwolfConfig& kcfg = base::CamouwolfConfig::Get();
+  if (const auto v = kcfg.GetString("webGpu:vendor")) {
+    vendor_ = String::FromUtf8(*v);
+  }
+  if (const auto v = kcfg.GetString("webGpu:architecture")) {
+    architecture_ = String::FromUtf8(*v);
+  }
+  if (const auto v = kcfg.GetString("webGpu:device")) {
+    device_ = String::FromUtf8(*v);
+  }
+  // Subgroup sizes differ between GPU families, so a claimed vendor reporting
+  // the host's sizes would contradict itself.
+  if (const auto v = kcfg.GetUint32("webGpu:subgroupMinSize")) {
+    subgroup_min_size_ = *v;
+  }
+  if (const auto v = kcfg.GetUint32("webGpu:subgroupMaxSize")) {
+    subgroup_max_size_ = *v;
+  }
+}
 
