 V8GPUTextureFormat GPU::getPreferredCanvasFormat() {
+  // CAMOUWOLF: the claimed platform's preferred canvas format.
+  //
+  // This is an OS tell, not a GPU one: GetPreferredCanvasFormat() below is
+  // "rgba8unorm" on Linux and Android and "bgra8unorm" on Windows and macOS,
+  // decided by #if. A Linux host claiming Windows therefore answers
+  // "rgba8unorm" from an API that takes no permission and no adapter.
+  //
+  // Only the value script reads is changed. The internal
+  // GetPreferredCanvasFormat() keeps the host's answer, because the swap chain
+  // really is better off in the host's format (that is what the #if is for);
+  // both formats are valid for a canvas context on every platform, so a page
+  // that configures with the claimed one still works.
+  if (const auto format =
+          base::CamouwolfConfig::Get().GetString("webGpu:preferredCanvasFormat")) {
+    if (*format == "bgra8unorm") {
+      return FromDawnEnum(wgpu::TextureFormat::BGRA8Unorm);
+    }
+    if (*format == "rgba8unorm") {
+      return FromDawnEnum(wgpu::TextureFormat::RGBA8Unorm);
+    }
+  }
   return FromDawnEnum(GetPreferredCanvasFormat());
 }
 
