 GPUSupportedLimits::GPUSupportedLimits(const ComboLimits& limits) {
   limits.UnlinkedCopyTo(&limits_);
+}
+
+// CAMOUWOLF: adapter.limits from the claimed adapter.
+//
+// `webGpu:limits` is a map of limit name (the IDL spelling, as in
+// SUPPORTED_LIMITS above) to number. The limits are tiered by hardware class
+// the same way WebGL's are — maxTextureDimension2D is 8192 on the software
+// adapter and on most mobile GPUs, 16384 on desktop ones — so an adapter info
+// naming a desktop GPU beside a software adapter's limits is the WebGPU form
+// of the mismatch 0007 closes for WebGL.
+//
+// Each value can only make the adapter look LESS capable than the host: a
+// "max" limit is the smaller of the two, a "min…Alignment" limit the larger.
+// requestDevice() passes requiredLimits to Dawn, which checks them against the
+// real adapter; advertising more than the host has would let a page ask for
+// what was advertised and be refused, which no real adapter does.
+// static
+void GPUSupportedLimits::CamouwolfApplyConfiguredLimits(ComboLimits* limits) {
+  const base::DictValue* configured =
+      base::CamouwolfConfig::Get().GetDict("webGpu:limits");
+  if (!configured) {
+    return;
+  }
+#define X(name)                                                       \
+  if (const base::Value* value = configured->Find(#name)) {           \
+    if (const std::optional<double> number = value->GetIfDouble()) {  \
+      using T = decltype(GPUSupportedLimits::ComboLimits::name);      \
+      const T claimed = base::saturated_cast<T>(*number);             \
+      limits->name = std::string_view(#name).starts_with("min")       \
+                         ? std::max<T>(limits->name, claimed)         \
+                         : std::min<T>(limits->name, claimed);        \
+    }                                                                 \
+  }
+  SUPPORTED_LIMITS(X)
+#undef X
 }
 
