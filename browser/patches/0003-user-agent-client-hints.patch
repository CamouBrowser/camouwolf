+// CAMOUWOLF: the configured brand list, verbatim and in the order given.
+//
+// A Chromium-branded build has no product brand to add (the #if below), so it
+// sends `"Not?A_Brand";v="24", "Chromium";v="158"` — two brands, where every
+// real Chrome sends three with "Google Chrome" among them. Sec-CH-UA goes out
+// on every request with no opt-in, so that is readable server-side before any
+// script runs, and it contradicts a UA string that says Chrome.
+//
+// The order is NOT recomputed here. Chrome permutes the list with a seed
+// derived from the major version (GenerateBrandVersionList below), so the
+// position and spelling of the GREASE entry are themselves a function of the
+// claimed version; the launcher computes that permutation for the version it
+// claims and this serves what it decided. Returns nullopt when the key is
+// absent or holds no usable entry, so the caller builds upstream's list.
+std::optional<blink::UserAgentBrandList> CamouwolfBrandList(
+    const base::ListValue* list) {
+  if (!list) {
+    return std::nullopt;
+  }
+  blink::UserAgentBrandList brands;
+  for (const base::Value& item : *list) {
+    const base::DictValue* entry = item.GetIfDict();
+    if (!entry) {
+      continue;
+    }
+    const std::string* brand = entry->FindString("brand");
+    const std::string* version = entry->FindString("version");
+    if (brand && version) {
+      brands.emplace_back(*brand, *version);
+    }
+  }
+  if (brands.empty()) {
+    return std::nullopt;
+  }
+  return brands;
+}
+
 const blink::UserAgentBrandList GetUserAgentBrandList(
     const std::string& major_version,
     const std::string& full_version,
     blink::UserAgentBrandVersionType output_version_type,
     std::optional<blink::UserAgentBrandVersion> additional_brand_version) {
+  // CAMOUWOLF: every brand list in the process is built here — the metadata
+  // behind Sec-CH-UA / Sec-CH-UA-Full-Version-List and
+  // navigator.userAgentData, and the public GetUserAgentBrand*VersionList()
+  // wrappers — so one hook covers them all. `additional_brand_version` is
+  // dropped on purpose: it is an embedder's extra brand (WebView), and the
+  // configured list is already the complete one.
+  const base::CamouwolfConfig& kcfg = base::CamouwolfConfig::Get();
+  if (auto configured = CamouwolfBrandList(
+          output_version_type == blink::UserAgentBrandVersionType::kFullVersion
+              ? kcfg.GetList("userAgentData.fullVersionList")
+              : kcfg.GetList("userAgentData.brands"))) {
+    return *configured;
+  }
   int major_version_number;
   bool parse_result = base::StringToInt(major_version, &major_version_number);
   DCHECK(parse_result);
