+// CAMOUWOLF: one getParameter() value from the identity.
+//
+// A WebGL2 context reads `webGl2:parameters`; a WebGL1 context reads
+// `webGl:parameters`. They are separate maps because the two contexts really
+// do answer differently on one GPU — VERSION and SHADING_LANGUAGE_VERSION
+// always, and a WebGL2-only name such as MAX_3D_TEXTURE_SIZE has no WebGL1
+// answer at all — and a page that opens both compares them. When the identity
+// carries no `webGl2:parameters` map at all, a WebGL2 context falls back to
+// `webGl:parameters`, which is what this patch did before the second map
+// existed; a name missing from a map that IS present is the host's answer.
+//
+// JSON null is a configured null: the parameter is one this GPU does not have.
+// A list becomes the typed array upstream returns for that name — Float32Array
+// for the float ranges and colours, Int32Array otherwise.
+std::optional<ScriptValue> WebGLRenderingContextBase::CamouwolfParameter(
+    ScriptState* script_state,
+    GLenum pname) {
+  const base::CamouwolfConfig& kcfg = base::CamouwolfConfig::Get();
+  const base::DictValue* params = nullptr;
+  if (IsWebGL2()) {
+    params = kcfg.GetDict("webGl2:parameters");
+  }
+  if (!params) {
+    params = kcfg.GetDict("webGl:parameters");
+  }
+  if (!params) {
+    return std::nullopt;
+  }
+  const base::Value* v = params->Find(base::NumberToString(pname));
+  if (!v) {
+    return std::nullopt;
+  }
+  if (v->is_none()) {
+    return ScriptValue::CreateNull(script_state->GetIsolate());
+  }
+  if (v->is_int()) {
+    return WebGLAny(script_state, v->GetInt());
+  }
+  if (v->is_double()) {
+    // base::Value parses anything past int32 as a double, and WebGL2 has
+    // limits up there (MAX_ELEMENT_INDEX is 4294967295, MAX_SERVER_WAIT_TIMEOUT
+    // near 2**63). Through float those round, so whole numbers in int64's
+    // range go out as integers, as upstream's int64 getter answers them.
+    const double number = v->GetDouble();
+    if (number == std::floor(number) && std::abs(number) < 9223372036854775808.0) {
+      return WebGLAny(script_state, static_cast<int64_t>(number));
+    }
+    return WebGLAny(script_state, static_cast<float>(number));
+  }
+  if (v->is_bool()) {
+    return WebGLAny(script_state, v->GetBool());
+  }
+  if (v->is_string()) {
+    return WebGLAny(script_state, String::FromUtf8(v->GetString()));
+  }
+  if (const base::ListValue* list = v->GetIfList()) {
+    bool as_float = false;
+    switch (pname) {
+      case GL_ALIASED_POINT_SIZE_RANGE:
+      case GL_ALIASED_LINE_WIDTH_RANGE:
+      case GL_DEPTH_RANGE:
+      case GL_BLEND_COLOR:
+      case GL_COLOR_CLEAR_VALUE:
+        as_float = true;
+        break;
+      default:
+        break;
+    }
+    // Every array-valued name upstream answers with a Float32Array or an
+    // Int32Array has two or four elements (see GetWebGLFloatArrayParameter /
+    // GetWebGLIntArrayParameter below). Anything longer is not one of them.
+    std::array<GLfloat, 4> floats = {0};
+    std::array<GLint, 4> ints = {0};
+    if (list->size() > floats.size()) {
+      return std::nullopt;
+    }
+    size_t length = 0;
+    for (const base::Value& item : *list) {
+      // GetIfDouble() answers for an int as well; anything else is malformed
+      // and the host's value is the safer answer.
+      const std::optional<double> number = item.GetIfDouble();
+      if (!number) {
+        return std::nullopt;
+      }
+      floats[length] = static_cast<GLfloat>(*number);
+      ints[length] = static_cast<GLint>(*number);
+      ++length;
+    }
+    if (as_float) {
+      return WebGLAny(script_state,
+                      DOMFloat32Array::Create(base::span(floats).first(length)));
+    }
+    return WebGLAny(script_state,
+                    DOMInt32Array::Create(base::span(ints).first(length)));
+  }
+  return std::nullopt;
+}
