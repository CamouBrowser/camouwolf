+// One event of an utterance the identity engine "speaks", at its offset from
+// the start of speech.
+struct ScheduledTtsEvent {
+  base::TimeDelta at;
+  TtsEventType type;
+  int char_index;
+  int length;
+};
+
+// Pace of a real engine at rate 1, measured on macOS Chrome with a local voice
+// (Samantha) and a network voice (Google): the start event, the lead before
+// the first word, and the time per UTF-16 character. Events after the start
+// scale with 1/rate, as they did there.
+constexpr base::TimeDelta kLocalStartDelay = base::Milliseconds(4);
+constexpr base::TimeDelta kNetworkStartDelay = base::Milliseconds(409);
+constexpr base::TimeDelta kLeadBeforeFirstWord = base::Milliseconds(110);
+constexpr base::TimeDelta kLocalPerChar = base::Milliseconds(57);
+constexpr base::TimeDelta kNetworkPerChar = base::Milliseconds(80);
 
