+void TtsPlatformImplLinux::SpeakAsIdentity(
+    int utterance_id,
+    const VoiceData& voice,
+    double rate,
+    const std::string& parsed_utterance) {
+  // A voice GetVoices listed carries its events; one that matched none of the
+  // identity's voices has none and is paced as a network voice.
+  const bool local = !voice.remote && !voice.events.empty();
+  // The utterance rate is a multiplier of the voice's normal pace, clamped to
+  // the range the Web Speech API allows.
+  const double pace = 1.0 / std::clamp(rate, 0.1, 10.0);
+  const base::TimeDelta start = local ? kLocalStartDelay : kNetworkStartDelay;
+  const base::TimeDelta per_char = local ? kLocalPerChar : kNetworkPerChar;
+  // Positions are UTF-16 offsets, the unit charIndex has in the page.
+  const std::u16string text = base::UTF8ToUTF16(parsed_utterance);
+  auto at = [&](size_t index) {
+    return start + (kLeadBeforeFirstWord + per_char * index) * pace;
+  };
+
+  identity_schedule_.clear();
+  identity_schedule_.push_back({start, TTS_EVENT_START, 0, -1});
+  bool sentence_start = true;
+  for (size_t i = 0; i < text.size();) {
+    if (base::IsUnicodeWhitespace(text[i])) {
+      ++i;
+      continue;
+    }
+    size_t end = i;
+    while (end < text.size() && !base::IsUnicodeWhitespace(text[end])) {
+      ++end;
+    }
+    if (local && identity_sentences_ && sentence_start) {
+      identity_schedule_.push_back(
+          {at(i), TTS_EVENT_SENTENCE, static_cast<int>(i), -1});
+    }
+    if (local && identity_words_) {
+      identity_schedule_.push_back({at(i), TTS_EVENT_WORD, static_cast<int>(i),
+                                    static_cast<int>(end - i)});
+    }
+    const char16_t last = text[end - 1];
+    sentence_start = last == u'.' || last == u'!' || last == u'?';
+    i = end;
+  }
+  identity_schedule_.push_back({at(text.size()), TTS_EVENT_END,
+                                static_cast<int>(text.size()), 0});
+
+  utterance_id_ = utterance_id;
+  identity_next_ = 0;
+  identity_started_ = base::TimeTicks::Now();
+  identity_paused_at_ = base::TimeDelta();
+  ArmIdentityTimer();
+}
+
+void TtsPlatformImplLinux::ArmIdentityTimer() {
+  // A pause can arrive before the utterance is scheduled.
+  if (paused_ || identity_next_ >= identity_schedule_.size()) {
+    return;
+  }
+  const base::TimeDelta elapsed = base::TimeTicks::Now() - identity_started_;
+  identity_timer_.Start(
+      FROM_HERE,
+      std::max(base::TimeDelta(),
+               identity_schedule_[identity_next_].at - elapsed),
+      base::BindOnce(&TtsPlatformImplLinux::OnIdentityEvent,
+                     base::Unretained(this)));
+}
+
+void TtsPlatformImplLinux::OnIdentityEvent() {
+  const ScheduledTtsEvent event = identity_schedule_[identity_next_++];
+  const int utterance_id = utterance_id_;
+  if (event.type == TTS_EVENT_END) {
+    is_speaking_ = false;
+    utterance_id_ = kInvalidUtteranceId;
+    identity_schedule_.clear();
+  } else {
+    ArmIdentityTimer();
+  }
+  TtsController::GetInstance()->OnTtsEvent(utterance_id, event.type,
+                                           event.char_index, event.length,
+                                           std::string());
+}
