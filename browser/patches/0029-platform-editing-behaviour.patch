+// CAMOUWOLF: the editing conventions of the OS navigator.platform claims.
+// Blink picks them at compile time, and a page can measure them: on Windows
+// Ctrl+Right stops after the space, a double-click takes the trailing space,
+// and a middle click autoscrolls rather than pasting the X11 selection.
+std::optional<mojom::EditingBehavior> CamouwolfEditingBehavior() {
+  const auto platform =
+      base::CamouwolfConfig::Get().GetString("navigator.platform");
+  if (platform == "Win32") {
+    return mojom::EditingBehavior::kEditingWindowsBehavior;
+  }
+  if (platform == "MacIntel") {
+    return mojom::EditingBehavior::kEditingMacBehavior;
+  }
+  return std::nullopt;
+}
+
 }  // namespace
 
