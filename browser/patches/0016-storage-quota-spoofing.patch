   StorageEstimate* estimate = StorageEstimate::Create();
   estimate->setUsage(usage_in_bytes);
-  estimate->setQuota(quota_in_bytes);
+  // CAMOUWOLF: navigator.storage.estimate().quota.
+  //
+  // Chrome sets the quota to ~60% of free disk, so this number is a direct
+  // read of the host's free space — stable, high-entropy, and completely
+  // uncorrelated with anything the identity claims. Two "different" browsers
+  // reporting the same odd quota are the same machine, which makes it a
+  // first-class cross-session linking signal. The launcher derives a plausible
+  // value from the persona's claimed disk rather than leaking the real one.
+  if (const auto q = base::CamouwolfConfig::Get().GetDouble("storage.quota")) {
+    estimate->setQuota(static_cast<int64_t>(*q));
+  } else {
+    estimate->setQuota(quota_in_bytes);
+  }
 
