+
+  // CAMOUWOLF: the pointer is the identity's devices, not the host's: a
+  // desktop's mouse, and a touchscreen beside it when it claims touch points,
+  // so a touch identity matches (any-pointer: coarse) and keeps (pointer: fine)
+  // and (hover: hover). It is stated whole, headless or not, because a
+  // command-line pointer (Playwright's headless --blink-settings) would answer
+  // for every browser context. It is applied here, not in the cache they all
+  // share, so a page takes the identity of the context it loads in.
+  if (const auto touch_points =
+          base::CamouwolfConfig::Get().GetInt("navigator.maxTouchPoints")) {
+    prefs->pointer_events_max_touch_points = *touch_points;
+    prefs->primary_pointer_type = blink::mojom::PointerType::kPointerFineType;
+    prefs->primary_hover_type = blink::mojom::HoverType::kHoverHoverType;
+    prefs->available_hover_types = ui::HOVER_TYPE_HOVER;
+    prefs->available_pointer_types =
+        ui::POINTER_TYPE_FINE | (*touch_points > 0 ? ui::POINTER_TYPE_COARSE : 0);
+  }
