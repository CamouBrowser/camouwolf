+// The deterministic opcode whose result ARM64 gives a relaxed SIMD opcode, for
+// --camouwolf-arm64-fp. The dot products, qfma and qfms have none; the
+// unsigned truncations already match.
+constexpr WasmOpcode Arm64EquivalentSimdOpcode(WasmOpcode opcode) {
+  switch (opcode) {
+    case kExprI8x16RelaxedSwizzle:
+      return kExprI8x16Swizzle;
+    case kExprI8x16RelaxedLaneSelect:
+    case kExprI16x8RelaxedLaneSelect:
+    case kExprI32x4RelaxedLaneSelect:
+    case kExprI64x2RelaxedLaneSelect:
+      return kExprS128Select;
+    case kExprF32x4RelaxedMin:
+      return kExprF32x4Min;
+    case kExprF32x4RelaxedMax:
+      return kExprF32x4Max;
+    case kExprF64x2RelaxedMin:
+      return kExprF64x2Min;
+    case kExprF64x2RelaxedMax:
+      return kExprF64x2Max;
+    case kExprI32x4RelaxedTruncF32x4S:
+      return kExprI32x4SConvertF32x4;
+    case kExprI32x4RelaxedTruncF64x2SZero:
+      return kExprI32x4TruncSatF64x2SZero;
+    case kExprI16x8RelaxedQ15MulRS:
+      return kExprI16x8Q15MulRSatS;
+    default:
+      return opcode;
