+// Replaces a NaN result with the one ARM64 computes from the same operands.
+// A NaN min or max has no result yet, and without the flag gets the x64 one.
+class OutOfLineArm64NaN final : public OutOfLineCode {
+ public:
+  using Input = MacroAssembler::Arm64NaNInput;
+  using Rule = MacroAssembler::Arm64NaNRule;
+
+  OutOfLineArm64NaN(CodeGenerator* gen, XMMRegister result, XMMRegister scratch,
+                    int lane_bits, Rule rule,
+                    std::initializer_list<Input> inputs, int negated = 0,
+                    bool negate_result = false, bool min_max = false)
+      : OutOfLineCode(gen),
+        result_(result),
+        scratch_(scratch),
+        lane_bits_(lane_bits),
+        rule_(rule),
+        count_(static_cast<int>(inputs.size())),
+        negated_(negated),
+        negate_result_(negate_result),
+        min_max_(min_max) {
+    std::copy(inputs.begin(), inputs.end(), inputs_);
+  }
+
+  void Generate() final {
+    if (masm()->options().isolate_independent_code) {
+      Label emulate;
+      __ cmpb(__ ExternalReferenceAsOperand(
+                  ExternalReference::address_of_camouwolf_arm64_fp_flag(),
+                  kScratchRegister),
+              Immediate(0));
+      __ j(not_equal, &emulate, Label::kNear);
+      if (min_max_ && lane_bits_ == 64) {
+        __ Xorpd(result_, result_);
+        __ Divsd(result_, result_);
+      } else if (min_max_) {
+        __ Xorps(result_, result_);
+        __ Divss(result_, result_);
+      }
+      __ jmp(exit());
+      __ bind(&emulate);
+    }
+    __ Arm64NaN(result_, scratch_, lane_bits_, rule_,
+                base::VectorOf(inputs_, count_), negated_, negate_result_);
+  }
+
+ private:
+  XMMRegister const result_;
+  XMMRegister const scratch_;
+  int const lane_bits_;
+  Rule const rule_;
+  Input inputs_[3];
+  int const count_;
+  int const negated_;
+  bool const negate_result_;
+  bool const min_max_;
+};
+
+// The same for every NaN lane of a 128-bit result. Only JIT code has SIMD.
+class OutOfLineArm64NaNLanes final : public OutOfLineCode {
+ public:
+  using Rule = MacroAssembler::Arm64NaNRule;
+
+  OutOfLineArm64NaNLanes(CodeGenerator* gen, XMMRegister result, int lane_bits,
+                         Rule rule, XMMRegister in0, XMMRegister in1,
+                         XMMRegister in2, int count, int negated)
+      : OutOfLineCode(gen),
+        result_(result),
+        lane_bits_(lane_bits),
+        rule_(rule),
+        inputs_{in0, in1, in2},
+        count_(count),
+        negated_(negated) {}
+
+  void Generate() final {
+    switch (count_) {
+      case 1:
+        __ Arm64NaNLanes(result_, lane_bits_, rule_, {inputs_[0]}, negated_);
+        break;
+      case 2:
+        __ Arm64NaNLanes(result_, lane_bits_, rule_, {inputs_[0], inputs_[1]},
+                         negated_);
+        break;
+      default:
+        __ Arm64NaNLanes(result_, lane_bits_, rule_,
+                         {inputs_[0], inputs_[1], inputs_[2]}, negated_);
+        break;
+    }
+  }
+
+ private:
+  XMMRegister const result_;
+  int const lane_bits_;
+  Rule const rule_;
+  XMMRegister const inputs_[3];
+  int const count_;
+  int const negated_;
 };
 
