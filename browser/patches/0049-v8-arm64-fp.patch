+// The input of a multiplication that ARM64 fuses with it into FNMUL, or -1.
+template <typename NegateMask>
+int Arm64FnmulInput(InstructionSelector* selector, OpIndex node) {
+  if (!v8_flags.camouwolf_arm64_fp) return -1;
+  const FloatBinopOp& mul = selector->Cast<FloatBinopOp>(node);
+  for (int k = 0; k < 2; k++) {
+    if (selector->Get(mul.input(k)).Is<NegateMask>() &&
+        selector->CanCover(node, mul.input(k))) {
+      return k;
+    }
+  }
+  return -1;
+}
