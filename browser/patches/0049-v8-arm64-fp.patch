+void MacroAssembler::Arm64NaN(XMMRegister dst, XMMRegister scratch,
+                              int lane_bits, Arm64NaNRule rule,
+                              base::Vector<const Arm64NaNInput> inputs,
+                              int negated, bool negate_result) {
+  ASM_CODE_COMMENT(this);
+  DCHECK(lane_bits == 32 || lane_bits == 64);
+  DCHECK_IMPLIES(rule == Arm64NaNRule::kMulAdd, inputs.size() == 3);
+  DCHECK_LE(inputs.size(), 3);
+  const bool f64 = lane_bits == 64;
+  const Register bits = kScratchRegister;
+  const uint64_t default_nan =
+      f64 ? uint64_t{0x7FF8000000000000} : uint64_t{0x7FC00000};
+#ifdef DEBUG
+  for (const Arm64NaNInput& in : inputs) DCHECK_NE(in.reg, scratch);
+#endif
+
+  auto flip_sign = [&]() {
+    if (f64) {
+      rolq(bits, Immediate(1));
+      xorq(bits, Immediate(1));
+      rorq(bits, Immediate(1));
+    } else {
+      xorl(bits, Immediate(kMinInt));
+    }
+  };
+  // Loads operand {i} into {bits} and sets the parity flag if it is a NaN.
+  auto load = [&](int i) {
+    const Arm64NaNInput& in = inputs[i];
+    if (f64 && in.reg.is_valid()) {
+      Movq(bits, in.reg);
+    } else if (f64) {
+      movq(bits, in.mem);
+    } else if (in.reg.is_valid()) {
+      Movd(bits, in.reg);
+    } else {
+      movl(bits, in.mem);
+    }
+    if (negated & (1 << i)) flip_sign();
+    if (f64) {
+      Movq(scratch, bits);
+      Ucomisd(scratch, scratch);
+    } else {
+      Movd(scratch, bits);
+      Ucomiss(scratch, scratch);
+    }
+  };
+  // Loads operand {i} into {scratch}, or applies {op} to {scratch} and it.
+  auto use = [&](int i, auto op) {
+    const Arm64NaNInput& in = inputs[i];
+    if (in.reg.is_valid()) {
+      op(in.reg);
+    } else {
+      op(in.mem);
+    }
+  };
+
+  const int count = static_cast<int>(inputs.size());
+  Label done, pass2;
+  for (int i = 0; i < count; i++) {
+    Label next;
+    load(i);
+    j(parity_odd, &next, Label::kNear);
+    // Sets the quiet bit; it was clear if the NaN was signalling.
+    btsq(bits, Immediate(f64 ? 51 : 22));
+    j(not_carry, &done);
+    bind(&next);
+  }
+  if (rule == Arm64NaNRule::kMulAdd) {
+    // Only a quiet NaN addend is left to beat inf * 0, and a NaN factor
+    // loses to it anyway.
+    load(0);
+    j(parity_odd, &pass2, Label::kNear);
+    use(1, [&](auto a) { f64 ? Movsd(scratch, a) : Movss(scratch, a); });
+    use(2, [&](auto b) { f64 ? Ucomisd(scratch, b) : Ucomiss(scratch, b); });
+    j(parity_even, &pass2, Label::kNear);
+    use(2, [&](auto b) { f64 ? Mulsd(scratch, b) : Mulss(scratch, b); });
+    if (f64) {
+      Ucomisd(scratch, scratch);
+    } else {
+      Ucomiss(scratch, scratch);
+    }
+    j(parity_odd, &pass2, Label::kNear);
+    movq(bits, default_nan);
+    jmp(&done, Label::kNear);
+  }
+  bind(&pass2);
+  for (int i = 0; i < count; i++) {
+    load(i);
+    j(parity_even, &done, Label::kNear);
+  }
+  movq(bits, default_nan);
+  bind(&done);
+  if (negate_result) flip_sign();
+  if (f64) {
+    Movq(dst, bits);
+  } else {
+    Movd(dst, bits);
+  }
+}
+
+void MacroAssembler::Arm64NaNLanes(XMMRegister dst, int lane_bits,
+                                   Arm64NaNRule rule,
+                                   std::initializer_list<XMMRegister> inputs,
+                                   int negated) {
+  ASM_CODE_COMMENT(this);
+  const int count = static_cast<int>(inputs.size());
+  const int lane_bytes = lane_bits / kBitsPerByte;
+  const int frame = kSimd128Size * (count + 1);
+  // The lanes are rewritten in memory: the result at rsp, operand k at
+  // rsp + 16 * (k + 1). {dst} is free to use once stored.
+  AllocateStackSpace(frame);
+  Movdqu(Operand(rsp, 0), dst);
+  for (int k = 0; k < count; k++) {
+    Movdqu(Operand(rsp, kSimd128Size * (k + 1)), inputs.begin()[k]);
+  }
+  for (int offset = 0; offset < kSimd128Size; offset += lane_bytes) {
+    Label next;
+    auto in = [&](int k) {
+      return Operand(rsp, kSimd128Size * (k + 1) + offset);
+    };
+    if (lane_bits == 64) {
+      Movsd(dst, Operand(rsp, offset));
+      Ucomisd(dst, dst);
+    } else {
+      Movss(dst, Operand(rsp, offset));
+      Ucomiss(dst, dst);
+    }
+    j(parity_odd, &next);
+    Arm64NaNInput lanes[3];
+    for (int k = 0; k < count; k++) lanes[k] = in(k);
+    Arm64NaN(dst, dst, lane_bits, rule, base::VectorOf(lanes, count), negated);
+    if (lane_bits == 64) {
+      movq(Operand(rsp, offset), kScratchRegister);
+    } else {
+      movl(Operand(rsp, offset), kScratchRegister);
+    }
+    bind(&next);
+  }
+  Movdqu(dst, Operand(rsp, 0));
+  addq(rsp, Immediate(frame));
+}
