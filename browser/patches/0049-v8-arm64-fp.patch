+void CodeStubAssembler::GotoIfArm64RoundsNaN(TNode<Float64T> x,
+                                             TVariable<Float64T>* var_x,
+                                             Label* done) {
+  Label is_nan(this), not_nan(this);
+  BranchIfFloat64IsNaN(x, &is_nan, &not_nan);
+  BIND(&is_nan);
+  GotoIfNot(IsArm64FpEmulated(), &not_nan);
+  // Adding a NaN to itself quiets it and keeps its sign and payload.
+  *var_x = Float64Add(x, x);
+  Goto(done);
+  BIND(&not_nan);
+}
