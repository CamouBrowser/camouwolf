+// Under --camouwolf-arm64-fp, emits a scalar float op with {emit} and gives a
+// NaN result the ARM64 value. An operand {dst} overwrites is kept in
+// kScratchDoubleReg2.
+template <typename EmitFn>
+inline void EmitWithArm64NaN(LiftoffAssembler* lasm, int lane_bits,
+                             DoubleRegister dst, DoubleRegister lhs,
+                             DoubleRegister rhs, EmitFn emit) {
+  if (!v8_flags.camouwolf_arm64_fp) return emit();
+  MacroAssembler::Arm64NaNInput in[2] = {lhs, rhs};
+  const int count = rhs.is_valid() ? 2 : 1;
+  if (lhs == dst || rhs == dst) lasm->Movaps(kScratchDoubleReg2, dst);
+  for (int k = 0; k < count; k++) {
+    if (in[k].reg == dst) in[k] = kScratchDoubleReg2;
+  }
+  emit();
+  Label done;
+  if (lane_bits == 64) {
+    lasm->Ucomisd(dst, dst);
+  } else {
+    lasm->Ucomiss(dst, dst);
+  }
+  lasm->j(parity_odd, &done);
+  lasm->Arm64NaN(dst, dst, lane_bits, MacroAssembler::Arm64NaNRule::kOperands,
+                 base::VectorOf(in, count));
+  lasm->bind(&done);
+}
+
+// The same for a float SIMD op, which {emit} writes to kScratchDoubleReg2 so
+// that its operands outlive it.
+template <typename EmitFn>
+inline void EmitSimdWithArm64NaN(
+    LiftoffAssembler* lasm, int lane_bits, LiftoffRegister dst,
+    std::initializer_list<XMMRegister> inputs, EmitFn emit,
+    MacroAssembler::Arm64NaNRule rule = MacroAssembler::Arm64NaNRule::kOperands,
+    int negated = 0) {
+  CpuFeatureScope avx_scope(lasm, AVX);
+  emit(kScratchDoubleReg2);
+  Label done;
+  if (lane_bits == 64) {
+    lasm->vcmpunordpd(kScratchDoubleReg, kScratchDoubleReg2,
+                      kScratchDoubleReg2);
+  } else {
+    lasm->vcmpunordps(kScratchDoubleReg, kScratchDoubleReg2,
+                      kScratchDoubleReg2);
+  }
+  lasm->vptest(kScratchDoubleReg, kScratchDoubleReg);
+  lasm->j(zero, &done);
+  lasm->Arm64NaNLanes(kScratchDoubleReg2, lane_bits, rule, inputs, negated);
+  lasm->bind(&done);
+  lasm->vmovaps(dst.fp(), kScratchDoubleReg2);
+}
