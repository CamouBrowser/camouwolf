 // static
 const AtomicString& LayoutThemeFontProvider::SystemFontFamily(
     CSSValueID system_font_id) {
+  // CAMOUWOLF: the CSS2 system-font keywords, which CreepJS's headless detector
+  // probes all six of (caption, icon, menu, message-box, small-caption,
+  // status-bar).
+  //
+  // Only THREE of them differ on Windows. layout_theme_font_provider_win.cc
+  // routes small-caption, menu and status-bar through the NONCLIENTMETRICS the
+  // browser process reads off the OS — normally Segoe UI — and lets caption,
+  // icon and message-box fall through to DefaultGUIFont(), which is "Arial" on
+  // every platform. So a Windows persona must answer Segoe UI for exactly those
+  // three and Arial for the rest; answering Segoe UI for all six would be as
+  // wrong as answering Arial for all six, just in the other direction.
+  //
+  // Linux needs nothing here: real Chrome on Linux uses this same file, so the
+  // unspoofed answer is already correct. macOS is handled by LayoutThemeMac,
+  // which is a different code path entirely.
+  if (const auto platform =
+          base::CamouwolfConfig::Get().GetString("navigator.platform")) {
+    if (*platform == "Win32") {
+      switch (system_font_id) {
+        case CSSValueID::kSmallCaption:
+        case CSSValueID::kMenu:
+        case CSSValueID::kStatusBar: {
+          DEFINE_THREAD_SAFE_STATIC_LOCAL(const AtomicString, kSegoeUi,
+                                          ("Segoe UI"));
+          return kSegoeUi;
+        }
+        default:
+          break;
+      }
+    }
+  }
   return DefaultGUIFont();
 }
 
