{
  "name": "camouwolf",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc && pnpm copy-files",
    "copy-files": "node scripts/copy-files.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build",
    "check:pack": "node scripts/check-pack.mjs",
    "golden": "${CAMOUWOLF_PYTHON:-$HOME/.cache/camouwolf-venv/bin/python} scripts/golden/launch_golden.py",
    "smoke": "pnpm build && node tests/manual/smoke_kraft.mjs"
  },
  "bin": {
    "camouwolf": "dist/__main__.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "keywords": [
    "camouwolf",
    "chromium",
    "playwright",
    "fingerprint",
    "anti-detect",
    "scraping"
  ],
  "author": "JWriter20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JWriter20/Camouwolf.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/JWriter20/Camouwolf/issues"
  },
  "engines": {
    "node": ">= 22.15"
  },
  "license": "MIT",
  "description": "Camouwolf: TypeScript launcher for the Camouwolf anti-detect Chromium browser. A port of the Python launcher.",
  "//playwright-core": "Range mirrors python/pyproject.toml's `playwright = \"<1.63\"`: src/switches.ts restates the --disable-features list of Playwright's Chromium launch, so the ceiling is bumped deliberately, checking chromiumSwitches against PLAYWRIGHT_DISABLED_FEATURES. The dev pin (1.62.0) is the version the Python venv resolves, so the goldens compare like with like.",
  "//@jwriter20/myuri": "Pinned to the release python/pyproject.toml pins, so a humanize seed plans the same input in both launchers.",
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@jwriter20/myuri": "4.0.0",
    "adm-zip": "^0.6.1",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.0",
    "fpgen-js": "1.3.0",
    "language-tags": "^2.0.1",
    "maxmind": "^5.0.0",
    "pretty-bytes": "^7.1.0",
    "python-random": "1.0.0",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/cli-progress": "^3.11.6",
    "@types/language-tags": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/xml2js": "^0.4.14",
    "playwright-core": "1.62.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "playwright-core": "<1.63"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.4",
      "onFail": "warn"
    }
  },
  "//engines": "22.15 for node:zlib zstd, which the fpgen model archive needs.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
