 "why": {
  "blend-alpha": "src-over blend rounding when many translucent layers accumulate",
  "blend-equations": "non-default blend equations: FUNC_SUBTRACT and the MIN/MAX path (EXT_blend_minmax)",
  "canvas2d-clip-alpha": "clip-path antialiasing composed with layer alpha: two AA stages stacked",
  "canvas2d-composite": "composite modes and shadows, which run through different GPU shaders",
  "canvas2d-conic": "createConicGradient: Holo patches the conical-gradient sqrt for Windows, so this is the scene that checks it",
  "canvas2d-drawimage-scale": "drawImage resampling and imageSmoothingQuality -- a filter choice with no spec",
  "canvas2d-filter": "the CSS/canvas filter chain -- separable blur, colour matrices",
  "canvas2d-lines": "joins, caps, miter limit and dash phase -- pure path geometry, no fill rule involved",
  "canvas2d-pattern": "pattern tiling under a non-axis-aligned transform: sampling and wrap at tile seams",
  "canvas2d-shadow": "shadowBlur: a separable Gaussian whose kernel and edge handling are implementation-defined",
  "canvas2d-shapes": "GPU-accelerated path fill/stroke, gradients and arcs -- no text involved",
  "canvas2d-text": "does DirectWrite glyph parity survive GPU-accelerated canvas?",
  "depth-test": "depth compare, the 1/w->depth mapping, and polygon offset",
  "derivatives": "dFdx/dFdy/fwidth: quad-level differencing, where the 2x2 layout and the coarse-vs-fine choice show",
  "fp-classic": "the scene commodity fingerprinters actually hash",
  "fragcoord-facing": "gl_FragCoord pixel-centre convention and gl_FrontFacing winding",
  "instanced": "ANGLE_instanced_arrays: instance-id plumbing and divisor handling",
  "interp-perspective": "perspective-correct interpolation: the 1/w divide",
  "interp-qualifiers": "flat vs smooth vs centroid interpolation, which the two stacks lower differently",
  "interp-varying": "barycentric interpolation of varyings across a large primitive",
  "numeric-bits": "exact 32-bit result of every ESSL builtin: shader-compiler parity",
  "numeric-bits-exact": "exact 32-bit shader results with inputs that are bit-identical BY CONSTRUCTION, so a divergence cannot be the probe's own input rounding",
  "point-coord": "gl_PointCoord generation across a fixed footprint: same size everywhere, so only the COORD is measured",
  "point-coord-bits": "exact 32 bits of gl_PointCoord: ANGLE emulates point sprites in shader code, Linux gets them from hardware, and 8-bit colour cannot resolve the difference",
  "point-size-ladder": "gl_PointSize rounding in isolation: flat colour, so only the FOOTPRINT is measured",
  "raster-lines": "line rasterisation rules differ most between D3D and GL",
  "raster-points": "gl_PointSize rounding and point sprite coverage",
  "raster-tri-flat": "fixed-function triangle coverage: fill rule and pixel-centre sampling",
  "raster-tri-msaa": "MSAA sample positions and the resolve filter (a driver/HW table)",
  "shader-int-bits": "integer and packing builtins: bit-exact by spec, so ANY difference here is a real bug or a real tell",
  "shader-mediump": "mediump math: drivers may evaluate it at fp16, and D3D and GL disagree about when",
  "stencil-ops": "stencil test and op rules (INCR/DECR wrap behaviour at the edges)",
  "tex-anisotropic": "anisotropic filtering: a quality knob with no spec'd algorithm, so a prime driver tell",
  "tex-array-3d": "2D-array and 3D texture sampling, including filtering across layers",
  "tex-bilinear": "bilinear weight quantisation (fixed-point sub-texel precision)",
  "tex-cube": "cube-map face selection and seam filtering",
  "tex-mip-generated": "generateMipmap's own downsample filter -- a driver implementation, not a spec'd one",
  "tex-mipmap": "LOD selection and trilinear blending across a minifying gradient",
  "tex-nearest": "nearest sampling: texel-centre rounding at exact boundaries",
  "tex-srgb": "sRGB decode on sample and encode on write -- a fixed conversion table that need not match",
